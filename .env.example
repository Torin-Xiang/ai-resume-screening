# 复制为 .env 后填入真实密钥。.env 已在 .gitignore 中，切勿提交。

# —— 模型 provider ——
# deepseek（推荐）/ qwen / openai / fake（离线演练，不联网）
# 留空时：配了 LLM_BASE_URL 或 LLM_API_KEY → 走通用兼容通道；否则默认 qwen
LLM_PROVIDER=deepseek

# —— 通用 OpenAI 兼容通道（DeepSeek / 自建网关 / 其他厂商）——
# provider=deepseek 时端点已内置，可不填 LLM_BASE_URL
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 模型名必须是**该账户下真实存在**的 id。查自己账户的合法取值：
#   curl -s -H "Authorization: Bearer $LLM_API_KEY" https://api.deepseek.com/models
#
# 实测教训（2026-09）：`deepseek-chat` / `deepseek-reasoner` 以及 V3 系列
# 已于 2026-07-24 **全局退役**，不是"某些账户不可用"——换账户也一样调不通。
# 当前只有两个：deepseek-v4-pro（贵、推理强）与 deepseek-flash（便宜、快）。
#
# 省钱提示：字段提取 + 维度评分这类任务用 deepseek-flash 就够，
# 单价约为 pro 的四分之一（且余额不足时换模型名也没用——402 是账户余额问题，
# 实测余额校验发生在模型名校验之前，写错模型名也先报余额不足）。
LLM_MODEL=deepseek-v4-pro

# —— 通义千问 DashScope 通道（provider=qwen 时使用）——
# 只认自己的变量名，不会回退到 LLM_API_KEY：那是别的厂商的密钥，
# 回退等于把凭据发给错误的端点。
DASHSCOPE_API_KEY=
# 可选：自建兼容端点
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 配好后可先自检（不发请求、不消耗 token）：
#   .venv/Scripts/python.exe scripts/check_llm_env.py
