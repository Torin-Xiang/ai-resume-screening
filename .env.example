# 复制为 .env 后填入真实密钥。.env 已在 .gitignore 中，切勿提交。

# 通义千问 DashScope API Key（必需；缺失时程序会明确报错，不会猜测）
DASHSCOPE_API_KEY=

# 模型 provider：qwen（默认） / fake（离线演练，不联网）
LLM_PROVIDER=qwen

# 模型名，如 qwen-plus / qwen-max / qwen-turbo
LLM_MODEL=qwen-plus

# 可选：自建兼容端点
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
