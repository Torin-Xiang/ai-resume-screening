# 工作记忆目录（本机 Agent 运行时数据，非项目内容）
.workbuddy/

# 环境变量与密钥
.env
.env.*
# 模板可入库，真实 .env 永不入库
!.env.example
*.local
# 任意以 .env 结尾的密钥文件（如手工命名的「API Key.env」）。
# 只写 .env / .env.* 挡不住这类命名——实测 `git check-ignore` 判定为未忽略，
# 意味着密钥会被直接提交进仓库。宁可规则宽一点，也不能漏。
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 运行产物（解析缓存 / 导出结果）与本地素材
# 方案 §9：脱敏简历样本与个人信息不得进 Git
data/
fixtures/
# README 与 CLI 示例中的默认简历目录；真实简历含个人信息，同样不得入库
resumes/
# 岗位 JD 属内部业务资料，默认不入库；若要共享示例 JD，用 git add -f 显式加入
jd/
*.xlsx

# Node.js
node_modules/
dist/
build/
*.log
*.tsbuildinfo

# 浏览器冒烟截图（每次运行都会重新生成，入库只会制造无意义的 diff）
web/e2e/*.png

# Office / WPS 临时文件（编辑简历、JD 文档时会产生）
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx

# 系统与编辑器
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
